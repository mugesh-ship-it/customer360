---
import '../styles/global.css';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';
import Seo from '../components/global/Seo.astro';
import Tracking from '../components/global/Tracking.astro';
import { CMS_URL, getHeader, getFooter, getDesign, getSiteSettings, getPageSummaries, pagePath, type Page } from '../lib/cms';
import { designCss, googleFontsUrl } from '../lib/design';
import { buildSeo, type SeoInput } from '../lib/seo';

/** Pass a CMS page, or `seo` directly for pages that aren't in the CMS (e.g. 404). */
type Props = ({ page: Page; seo?: never } | { page?: never; seo: SeoInput }) & {
  /** Lighter page background for pages that aren't in Pages (e.g. a case study). */
  light?: boolean;
  /** Draft preview rendered for the CMS: not indexed, no tracking, reloads when the editor saves. */
  preview?: boolean;
};

const props = Astro.props;
const [header, footer, design, settings, menuPages] = await Promise.all([getHeader(), getFooter(), getDesign(), getSiteSettings(), getPageSummaries()]);

const input: SeoInput = props.page
  ? { title: props.page.title, path: pagePath(props.page.slug), meta: props.page.meta, seo: props.page.seo }
  : props.seo!;
const seo = buildSeo(input, settings);
if (props.preview) seo.robots = 'noindex, nofollow';
const cmsOrigin = new URL(CMS_URL).origin;
const themeVars = designCss(design);
const fontsUrl = googleFontsUrl(design);
---

<!doctype html>
<html lang={seo.lang} class:list={[props.preview && 'is-preview']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo seo={seo} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsUrl} />
    {themeVars && <style is:inline set:html={themeVars} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    {!props.preview && <Tracking settings={settings} position="head" />}
    {
      props.preview && (
        <style is:inline>
          {`html.is-preview [data-reveal] { opacity: 1; transform: none; transition: none; }
          .preview_badge { position: fixed; z-index: 9999; right: 1rem; bottom: 1rem; padding: 0.5rem 0.875rem; border-radius: 999px;
            background: var(--color-neutral-900, #111); color: #fff; font: 600 0.75rem/1 system-ui, sans-serif; letter-spacing: 0.02em;
            pointer-events: none; opacity: 0.85; }`}
        </style>
      )
    }
  </head>
  <body class:list={[(props.page?.pageBackground === 'light' || props.light) && 'is-light']}>
    {!props.preview && <Tracking settings={settings} position="body" />}
    <div class="page-wrapper">
      <Navbar header={header} pages={menuPages} />
      <main class="main-wrapper">
        <slot />
      </main>
      <Footer footer={footer} />
    </div>

    <script>
      import { initScroll, reduceMotion } from '../lib/scroll';

      // Smooth scroll: lerp-based, native scroll position, rAF handled by Lenis.
      initScroll();

      // Reveal-on-scroll: one observer for the whole page, unobserve after reveal.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
    {!props.preview && <Tracking settings={settings} position="end" />}
    {
      props.preview && (
        <>
          <div class="preview_badge" aria-hidden="true">Draft preview</div>
          <script is:inline define:vars={{ cmsOrigin }}>
            // Payload live preview: say we're ready, then reload whenever the editor's draft is saved.
            // The scroll position survives the reload so the editor stays on the section they're editing.
            const KEY = 'preview-scroll:' + location.pathname;
            try {
              const y = sessionStorage.getItem(KEY);
              if (y !== null) {
                sessionStorage.removeItem(KEY);
                history.scrollRestoration = 'manual';
                addEventListener('load', () => scrollTo(0, Number(y)));
              }
            } catch {}
            if (window.parent !== window) window.parent.postMessage({ type: 'payload-live-preview', ready: true }, cmsOrigin);
            let timer;
            addEventListener('message', (event) => {
              if (event.origin !== cmsOrigin || event.data?.type !== 'payload-document-event') return;
              clearTimeout(timer);
              timer = setTimeout(() => {
                try { sessionStorage.setItem(KEY, String(scrollY)); } catch {}
                location.reload();
              }, 150);
            });
          </script>
        </>
      )
    }
  </body>
</html>
