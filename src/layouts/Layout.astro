---
import '../styles/global.css';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';
import Seo from '../components/global/Seo.astro';
import Tracking from '../components/global/Tracking.astro';
import { getHeader, getFooter, getDesign, getSiteSettings, pagePath, type Page } from '../lib/cms';
import { designCss, googleFontsUrl } from '../lib/design';
import { buildSeo, type SeoInput } from '../lib/seo';

/** Pass a CMS page, or `seo` directly for pages that aren't in the CMS (e.g. 404). */
type Props = ({ page: Page; seo?: never } | { page?: never; seo: SeoInput }) & {
  /** Lighter page background for pages that aren't in Pages (e.g. a case study). */
  light?: boolean;
};

const props = Astro.props;
const [header, footer, design, settings] = await Promise.all([getHeader(), getFooter(), getDesign(), getSiteSettings()]);

const input: SeoInput = props.page
  ? { title: props.page.title, path: pagePath(props.page.slug), meta: props.page.meta, seo: props.page.seo }
  : props.seo!;
const seo = buildSeo(input, settings);
const themeVars = designCss(design);
const fontsUrl = googleFontsUrl(design);
---

<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo seo={seo} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsUrl} />
    {themeVars && <style is:inline set:html={themeVars} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Tracking settings={settings} position="head" />
  </head>
  <body class:list={[(props.page?.pageBackground === 'light' || props.light) && 'is-light']}>
    <Tracking settings={settings} position="body" />
    <div class="page-wrapper">
      <Navbar header={header} />
      <main class="main-wrapper">
        <slot />
      </main>
      <Footer footer={footer} />
    </div>

    <script>
      import { initScroll, reduceMotion } from '../lib/scroll';

      // Smooth scroll: lerp-based, native scroll position, rAF handled by Lenis.
      initScroll();

      // Reveal-on-scroll: one observer for the whole page, unobserve after reveal.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
    <Tracking settings={settings} position="end" />
  </body>
</html>
