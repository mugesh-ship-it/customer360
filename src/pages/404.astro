---
/** Broken-link page. Text comes from SEO & tracking → Page not found. Never indexed. */
import Layout from '../layouts/Layout.astro';
import Button from '../components/global/Button.astro';
import { getSiteSettings } from '../lib/cms';

const settings = await getSiteSettings();
const nf = settings.notFound;
const heading = nf?.heading || 'Page not found';
---

<Layout seo={{ title: heading, path: '/404', noindex: true, seo: { hideFromSitemap: true } }}>
  <section class="section_not-found">
    <div class="padding-global">
      <div class="container-small">
        <div class="not-found_component padding-section-large text-align-center flex flex-col items-center gap-6">
          <p class="not-found_code heading-style-display text-primary-100" aria-hidden="true">404</p>
          <h1 class="not-found_heading heading-style-h2 text-neutral-900">{heading}</h1>
          {nf?.text && <p class="not-found_text text-size-large text-muted">{nf.text}</p>}
          <Button link={nf?.button} variant="icon" />
        </div>
      </div>
    </div>
  </section>
</Layout>
