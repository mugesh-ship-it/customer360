---
/** A case study's own page: /case-studies/<slug>. */
import CaseStudyArticle from '../../components/templates/CaseStudyArticle.astro';
import { getCaseStudies, type CaseStudy } from '../../lib/cms';

export async function getStaticPaths() {
  const items = await getCaseStudies();
  return items.filter((c) => c.slug && !c.url).map((c) => ({ params: { slug: c.slug! }, props: { item: c } }));
}

const { item } = Astro.props as { item: CaseStudy };
---

<CaseStudyArticle item={item} />
