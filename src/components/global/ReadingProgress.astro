---
/**
 * Thin brand line pinned to the top of the window that fills 0 → 100% as the
 * page is scrolled. One transform write per (Lenis) frame, no layout work.
 */
interface Props {
  label?: string;
}
const { label = 'Reading progress' } = Astro.props;
---

<div class="reading-progress" role="progressbar" aria-label={label} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-reading-progress>
  <span class="reading-progress_bar"></span>
</div>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 70;
    height: 3px;
    pointer-events: none;
    background: color-mix(in srgb, var(--color-primary-100) 60%, transparent);
  }
  .reading-progress_bar {
    display: block;
    height: 100%;
    transform-origin: 0 50%;
    transform: scaleX(var(--progress, 0));
    background: linear-gradient(90deg, var(--color-primary-400), var(--color-primary-700));
    will-change: transform;
  }
</style>

<script>
  import { onScroll } from '../../lib/scroll';

  const el = document.querySelector<HTMLElement>('[data-reading-progress]');
  if (el) {
    let max = 1;
    let last = -1;
    const measure = () => (max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight));
    measure();
    new ResizeObserver(measure).observe(document.body);
    onScroll((y) => {
      const p = Math.min(1, Math.max(0, y / max));
      el.style.setProperty('--progress', p.toFixed(4));
      const pct = Math.round(p * 100);
      if (pct !== last) el.setAttribute('aria-valuenow', String((last = pct)));
    });
  }
</script>
