---
import Button from './Button.astro';
import CmsImage from './CmsImage.astro';
import menuIcon from '../../assets/icons/menu.svg?raw';
import arrowCta from '../../assets/icons/arrow-cta.svg?raw';
import { pagePath, type Header, type PageSummary } from '../../lib/cms';
import { scopeSvgIds } from '../../lib/svg';

interface Props {
  header: Header;
  /** Every published CMS page; the drawer menu is built from these. */
  pages?: PageSummary[];
}
const { header, pages = [] } = Astro.props;

/**
 * Global drawer menu. Titles and URLs come from the CMS Pages collection, so a
 * new page shows up here by itself. Only the grouping lives in code: pages that
 * aren't listed fall into "More"; `a/b` pages nest under `a` when it exists.
 */
const GROUPS: { label: string; slugs: string[] }[] = [
  { label: 'Explore', slugs: ['home', 'about', 'services', 'products', 'case-studies'] },
  { label: 'Learn', slugs: ['resources', 'blog', 'faq'] },
  { label: 'Company', slugs: ['careers', 'contact'] },
];
const LEGAL = ['privacy', 'terms'];

const bySlug = new Map(pages.map((p) => [p.slug, p]));
const children = (slug: string) => pages.filter((p) => p.slug.startsWith(`${slug}/`) && p.slug.split('/').length === 2);
const listed = new Set([...GROUPS.flatMap((g) => g.slugs), ...LEGAL]);
const more = pages.filter((p) => !listed.has(p.slug) && !(p.slug.includes('/') && bySlug.has(p.slug.split('/')[0])));

const groups = [...GROUPS, { label: 'More', slugs: more.map((p) => p.slug) }]
  .map((g) => ({
    label: g.label,
    items: g.slugs
      .map((s) => bySlug.get(s))
      .filter((p): p is PageSummary => !!p)
      .map((p) => ({ page: p, kids: children(p.slug) })),
  }))
  .filter((g) => g.items.length);
const legal = LEGAL.map((s) => bySlug.get(s)).filter((p): p is PageSummary => !!p);

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (p: PageSummary) => pagePath(p.slug) === current;
const arrow = scopeSvgIds(arrowCta, 'menu-arrow');

// One running index across groups, used for the 01, 02… numbering and the stagger.
let n = 0;
const next = () => n++;
---

<header class="navbar_component relative z-50">
  <div class="padding-global">
    <div class="container-large">
      <nav class="navbar_container flex items-center justify-between gap-4 pt-6 lg:pt-10" aria-label="Main">
        <a href="/" class="navbar_logo-link flex items-center gap-2" aria-label={`${header.brandName} home`}>
          <CmsImage
            media={header.logo}
            class="navbar_logo h-10 w-auto mix-blend-multiply lg:h-12"
            loading="eager"
            decorative
          />
          <span class="navbar_brand font-brand text-[1.5rem] leading-none font-bold tracking-[-0.02em] text-ink lg:text-[1.75rem]">
            {header.brandName}
          </span>
        </a>

        <div class="navbar_actions relative flex items-center gap-2">
          <Button link={header.cta} variant="primary" class="hide-mobile-portrait" />

          <button
            type="button"
            class="navbar_menu-button flex size-(--button-height-large) items-center justify-center rounded-button bg-primary-100 transition-colors duration-300 hover:bg-primary-200"
            aria-controls="site-menu"
            aria-expanded="false"
            aria-haspopup="dialog"
            aria-label="Open menu"
          >
            <span class="navbar_menu-icon [&_svg]:h-[8.47px] [&_svg]:w-[25.41px]" aria-hidden="true" set:html={menuIcon} />
          </button>
        </div>
      </nav>
    </div>
  </div>

  <div class="site-menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Site menu" data-open="false" inert>
    <div class="site-menu_backdrop" data-menu-close></div>

    <aside class="site-menu_panel">
      <div class="site-menu_glow" aria-hidden="true"></div>

      <div class="site-menu_top">
        <span class="site-menu_eyebrow">Menu</span>
        <button type="button" class="site-menu_close" aria-label="Close menu" data-menu-close>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>

      <nav class="site-menu_nav" aria-label="All pages">
        {
          groups.map((group) => (
            <section class="site-menu_group">
              <p class="site-menu_label"><span>{group.label}</span></p>
              <ul class="site-menu_list">
                {group.items.map(({ page, kids }) => {
                  const i = next();
                  return (
                    <li style={`--i: ${i}`}>
                      <a href={pagePath(page.slug)} class="site-menu_link" aria-current={isCurrent(page) ? 'page' : undefined}>
                        <span class="site-menu_clip">
                          <span class="site-menu_row">
                            <span class="site-menu_num">{String(i + 1).padStart(2, '0')}</span>
                            <span class="site-menu_text">{page.title}</span>
                            <span class="site-menu_arrow" set:html={arrow} aria-hidden="true" />
                          </span>
                        </span>
                      </a>
                      {kids.length > 0 && (
                        <ul class="site-menu_sub">
                          {kids.map((kid) => (
                            <li>
                              <a href={pagePath(kid.slug)} class="site-menu_sublink" aria-current={isCurrent(kid) ? 'page' : undefined}>
                                <span class="site-menu_clip">
                                  <span class="site-menu_subtext">{kid.title}</span>
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
      </nav>

      <div class="site-menu_foot" style={`--i: ${n + 1}`}>
        <Button link={header.cta} variant="icon" />
        {
          legal.length > 0 && (
            <ul class="site-menu_legal">
              {legal.map((p) => (
                <li>
                  <a href={pagePath(p.slug)}>{p.title}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </aside>
  </div>
</header>

<style>
  /* ---------- Hamburger ---------- */
  .navbar_menu-button {
    transition:
      background-color 0.3s var(--ease-out-soft),
      transform 0.4s var(--ease-out-soft);
  }
  .navbar_menu-button:active {
    transform: scale(0.94);
  }
  .navbar_menu-icon :global(svg) {
    transition: transform 0.45s var(--ease-out-soft);
  }
  .navbar_menu-button:hover .navbar_menu-icon :global(svg) {
    transform: scaleX(0.78);
  }

  /* ---------- Drawer shell ---------- */
  .site-menu {
    --menu-ease: cubic-bezier(0.76, 0, 0.24, 1);
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.8s;
  }
  .site-menu[data-open='true'] {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .site-menu_backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-neutral-900) 22%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out-soft);
  }
  .site-menu[data-open='true'] .site-menu_backdrop {
    opacity: 1;
  }

  .site-menu_panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: min(34rem, 100vw);
    padding: 1.5rem 1.75rem 1.75rem;
    overflow: hidden auto;
    overscroll-behavior: contain;
    color: var(--color-ink);
    background: #fff;
    border-radius: 2rem 0 0 2rem;
    box-shadow: -24px 0 80px rgb(15 23 42 / 0.16);
    transform: translate3d(100%, 0, 0);
    transition: transform 0.8s var(--menu-ease);
  }
  .site-menu[data-open='true'] .site-menu_panel {
    transform: translate3d(0, 0, 0);
  }
  @media (min-width: 64rem) {
    .site-menu_panel {
      padding: clamp(1.25rem, 3.5vh, 2.25rem) 3rem clamp(1.25rem, 3.5vh, 2.5rem);
    }
  }
  @media (max-width: 40rem) {
    .site-menu_panel {
      border-radius: 0;
    }
  }

  /* Soft light that follows the pointer (position set from the script) */
  .site-menu_glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(28rem circle at var(--gx, 85%) var(--gy, 0%), color-mix(in srgb, var(--color-primary-200) 70%, transparent), transparent 70%);
    opacity: 0.9;
    transition: background-position 0.3s linear;
  }

  /* ---------- Top row ---------- */
  .site-menu_top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(1rem, 3vh, 2rem);
  }
  .site-menu_eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }
  .site-menu_close {
    position: relative;
    width: var(--button-height-large);
    height: var(--button-height-large);
    border-radius: 9999px;
    background: var(--color-primary-100);
    transition:
      background-color 0.3s var(--ease-out-soft),
      transform 0.6s var(--ease-out-soft);
  }
  .site-menu_close span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.25rem;
    height: 2px;
    margin: -1px 0 0 -0.625rem;
    border-radius: 2px;
    background: var(--color-ink);
  }
  .site-menu_close span:first-child {
    transform: rotate(45deg);
  }
  .site-menu_close span:last-child {
    transform: rotate(-45deg);
  }
  .site-menu_close:hover {
    background: var(--color-primary-200);
    transform: rotate(90deg);
  }

  /* ---------- Links ---------- */
  .site-menu_nav {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 3vh, 2rem);
  }
  .site-menu_label {
    margin: 0 0 0.25rem;
    padding-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
    border-bottom: 1px solid rgb(15 23 42 / 0.1);
  }
  .site-menu_list,
  .site-menu_sub {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-menu_nav:hover .site-menu_link,
  .site-menu_nav:hover .site-menu_sublink {
    opacity: 0.45;
  }
  .site-menu_nav:hover .site-menu_link:hover,
  .site-menu_nav:hover .site-menu_sublink:hover {
    opacity: 1;
  }
  .site-menu_link {
    display: block;
    padding: 0.1rem 0;
    transition: opacity 0.4s var(--ease-out-soft);
  }
  .site-menu_clip {
    display: block;
    overflow: hidden;
  }
  .site-menu_row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    transition: transform 0.55s var(--ease-out-soft);
  }
  .site-menu_link:hover .site-menu_row {
    transform: translate3d(0.75rem, 0, 0);
  }
  .site-menu_num {
    min-width: 1.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-neutral-400);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s var(--ease-out-soft);
  }
  .site-menu_text {
    font-family: var(--font-brand);
    font-size: clamp(1.5rem, min(1.3rem + 1.6vw, 4vh), 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .site-menu_arrow {
    display: inline-flex;
    align-self: center;
    margin-left: 0.25rem;
    opacity: 0;
    transform: translate3d(-0.5rem, 0, 0);
    transition:
      opacity 0.35s var(--ease-out-soft),
      transform 0.5s var(--ease-out-soft);
  }
  .site-menu_arrow :global(svg) {
    width: 1rem;
    height: 1rem;
    transform: rotate(-90deg);
  }
  .site-menu_arrow :global(path) {
    fill: var(--color-primary-600);
  }
  .site-menu_link:hover .site-menu_arrow,
  .site-menu_link:focus-visible .site-menu_arrow {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
  .site-menu_link:hover .site-menu_num {
    color: var(--color-primary-600);
  }
  .site-menu_link[aria-current='page'] .site-menu_text,
  .site-menu_sublink[aria-current='page'] .site-menu_subtext {
    color: var(--color-primary-600);
  }
  .site-menu_link[aria-current='page'] .site-menu_num::after {
    content: '';
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    margin-left: 0.375rem;
    border-radius: 9999px;
    background: var(--color-primary-600);
  }

  .site-menu_sub {
    margin: 0.125rem 0 0.375rem 2.75rem;
  }
  .site-menu_sublink {
    display: block;
    padding: 0.15rem 0;
    transition: opacity 0.4s var(--ease-out-soft);
  }
  .site-menu_subtext {
    display: block;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-neutral-600);
    transition:
      color 0.3s var(--ease-out-soft),
      transform 0.5s var(--ease-out-soft);
  }
  .site-menu_sublink:hover .site-menu_subtext {
    color: var(--color-ink);
    transform: translate3d(0.5rem, 0, 0);
  }

  /* ---------- Footer row ---------- */
  .site-menu_foot {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-top: auto;
    padding-top: clamp(1rem, 3vh, 2.5rem);
  }
  .site-menu_legal {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-menu_legal a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-neutral-500);
    transition: color 0.3s var(--ease-out-soft);
  }
  .site-menu_legal a:hover {
    color: var(--color-ink);
  }

  /* ---------- Staggered entrance (only when motion is welcome) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .site-menu_row,
    .site-menu_subtext {
      transform: translate3d(0, 110%, 0);
    }
    .site-menu_label,
    .site-menu_foot {
      opacity: 0;
      transform: translate3d(0, 0.75rem, 0);
    }
    .site-menu[data-open='true'] .site-menu_row,
    .site-menu[data-open='true'] .site-menu_subtext {
      transform: translate3d(0, 0, 0);
      transition:
        transform 0.9s var(--menu-ease) calc(0.3s + var(--i, 0) * 55ms),
        color 0.3s var(--ease-out-soft);
    }
    .site-menu[data-open='true'] .site-menu_link:hover .site-menu_row {
      transform: translate3d(0.75rem, 0, 0);
      transition-delay: 0s;
      transition-duration: 0.55s;
    }
    .site-menu[data-open='true'] .site-menu_sublink:hover .site-menu_subtext {
      transform: translate3d(0.5rem, 0, 0);
      transition-delay: 0s;
      transition-duration: 0.5s;
    }
    .site-menu[data-open='true'] .site-menu_label,
    .site-menu[data-open='true'] .site-menu_foot {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      transition:
        opacity 0.7s var(--ease-out-soft) 0.4s,
        transform 0.9s var(--menu-ease) 0.4s;
    }
    .site-menu[data-open='true'] .site-menu_foot {
      transition-delay: calc(0.35s + var(--i, 0) * 55ms);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-menu,
    .site-menu_panel,
    .site-menu_backdrop {
      transition-duration: 0.01s;
    }
  }
</style>

<script>
  import { getLenis } from '../../lib/scroll';

  const root = document.getElementById('site-menu');
  const button = document.querySelector<HTMLButtonElement>('.navbar_menu-button');
  if (root && button) {
    const panel = root.querySelector<HTMLElement>('.site-menu_panel')!;
    const focusable = () =>
      [...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter((el) => el.offsetParent !== null);
    const isOpen = () => root.dataset.open === 'true';

    const setOpen = (open: boolean) => {
      if (open === isOpen()) return;
      root.dataset.open = String(open);
      button.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('menu-open', open);
      if (open) {
        root.removeAttribute('inert');
        getLenis()?.stop();
        document.documentElement.style.overflow = 'hidden';
        // Wait a frame so the browser has the closed state before animating in.
        requestAnimationFrame(() => panel.querySelector<HTMLElement>('.site-menu_close')?.focus({ preventScroll: true }));
      } else {
        root.setAttribute('inert', '');
        document.documentElement.style.overflow = '';
        getLenis()?.start();
        button.focus({ preventScroll: true });
      }
    };

    button.addEventListener('click', () => setOpen(!isOpen()));
    root.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
    // Any link closes the drawer first, so same-page anchors (#about) can still scroll.
    panel.addEventListener('click', (e) => (e.target as Element).closest('a') && setOpen(false));

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') return setOpen(false);
      if (e.key !== 'Tab') return;
      const items = focusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) (e.preventDefault(), last.focus());
      else if (!e.shiftKey && document.activeElement === last) (e.preventDefault(), first.focus());
    });

    // Light that trails the pointer across the panel (fine pointers only).
    if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      panel.addEventListener('pointermove', (e) => {
        const r = panel.getBoundingClientRect();
        panel.style.setProperty('--gx', `${e.clientX - r.left}px`);
        panel.style.setProperty('--gy', `${e.clientY - r.top}px`);
      });
    }
  }
</script>
