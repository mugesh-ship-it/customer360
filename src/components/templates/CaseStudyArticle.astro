---
/**
 * A case study's article (used by /case-studies/<slug> and by the CMS draft preview).
 * Story = Payload rich text rendered at build time. Headings feed the sticky
 * "On this page" list (scroll-spy + fill line); a top bar shows page progress.
 * Labels come from Settings → Case study pages; the closing call-to-action is
 * the one on the Case Studies page.
 */
import Layout from '../../layouts/Layout.astro';
import CmsImage from '../global/CmsImage.astro';
import Illustration from '../global/Illustration.astro';
import SectionTag from '../global/SectionTag.astro';
import ReadingProgress from '../global/ReadingProgress.astro';
import CaseStudies from '../sections/CaseStudies.astro';
import Cta from '../sections/Cta.astro';
import chevron from '../../assets/icons/chevron.svg?raw';
import { getCaseStudies, getCaseStudyPage, getPageBySlug, populated, type BlockOf, type CaseStudy, type Media, type Service } from '../../lib/cms';
import { readingMinutes, renderRichText, type RichText } from '../../lib/richtext';

type Props = {
  item: CaseStudy;
  /** Draft preview from the CMS: no tracking, not indexed. */
  preview?: boolean;
};

const { item, preview } = Astro.props;
const slug = item.slug ?? '';
const all = await getCaseStudies();
const [tpl, listing] = await Promise.all([getCaseStudyPage(), getPageBySlug('case-studies')]);

const service = populated<Service>(item.service);
const { html, toc, words } = renderRichText(item.content as RichText);
const minutes = readingMinutes(words);
const listingPath = tpl.listingPath || '/case-studies';
const path = `/case-studies/${slug}`;

const facts = [
  { label: tpl.clientLabel, value: item.client },
  { label: tpl.industryLabel, value: item.industry },
  { label: tpl.serviceLabel, value: service?.title },
  { label: tpl.durationLabel, value: item.duration },
].filter((f) => f.value);

// More stories: same service first, then the newest.
const count = tpl.relatedCount ?? 4;
const others = all.filter((c) => c.id !== item.id);
const sameService = (c: CaseStudy) => populated<Service>(c.service)?.id === service?.id;
const related = [...others.filter(sameService), ...others.filter((c) => !sameService(c))].slice(0, count);
const relatedBlock = {
  blockType: 'caseStudies',
  id: `related-${item.id}`,
  tag: tpl.relatedTag,
  heading: tpl.relatedHeading || '',
  caseStudies: related,
} as BlockOf<'caseStudies'>;
const cta = listing?.layout?.find((b) => b.blockType === 'cta') as BlockOf<'cta'> | undefined;

const cover = populated<Media>(item.coverImage);
const published = item.publishedAt ? new Date(item.publishedAt) : null;
---

<Layout
  light
  preview={preview}
  seo={{
    title: item.title,
    path,
    meta: {
      title: item.meta?.title,
      description: item.meta?.description || item.excerpt,
      image: item.meta?.image || item.coverImage,
    },
    seo: { pageType: 'ItemPage', breadcrumbLabel: item.title },
  }}
>
  <ReadingProgress />

  <article class="section_case-study">
    {/* ---- Header ------------------------------------------------------- */}
    <header class="case-study_header relative">
      <div class="grid-line-v pointer-events-none absolute top-0 left-[calc(50%-2.25px)] h-24 max-lg:hidden" aria-hidden="true"></div>
      <div class="padding-global">
        <div class="container-large">
          <div class="case-study_intro pt-12 pb-10 lg:pt-[7.5rem] lg:pb-14">
            <nav class="case-study_breadcrumb mb-8 flex flex-wrap items-center gap-2 text-sm font-semibold tracking-[-0.02em] text-neutral-500" aria-label="Breadcrumb" data-reveal>
              <a href={listingPath} class="case-study_back inline-flex items-center gap-2 text-primary-700 transition-colors hover:text-primary-900">
                <span class="rotate-90 [&_svg]:h-2 [&_svg]:w-3.5" aria-hidden="true" set:html={chevron} />
                {tpl.listingLabel}
              </a>
              {service && (<><span aria-hidden="true">/</span><span>{service.title}</span></>)}
            </nav>
            {service && <SectionTag text={service.title} class="mb-7" data-reveal />}
            <h1 class="case-study_title heading-style-h1 max-w-[62rem] text-neutral-800 lg:leading-[1.2]" data-reveal>{item.title}</h1>
            {item.excerpt && (
              <p class="case-study_excerpt text-size-large mt-6 max-w-[46rem] leading-[1.64] text-neutral-700 lg:mt-8" data-reveal style="--reveal-delay: 100">
                {item.excerpt}
              </p>
            )}

            <div class="case-study_meta mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-neutral-300 bg-neutral-300 sm:grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] lg:mt-14" data-reveal style="--reveal-delay: 150">
              {facts.map((f) => (
                <div class="case-study_fact flex flex-col gap-2 bg-white px-5 py-5 lg:px-7 lg:py-6">
                  <span class="text-xs font-semibold tracking-[0.04em] text-neutral-500 uppercase">{f.label}</span>
                  <span class="text-base leading-snug font-semibold tracking-[-0.02em] text-neutral-800">{f.value}</span>
                </div>
              ))}
              <div class="case-study_fact flex flex-col gap-2 bg-white px-5 py-5 lg:px-7 lg:py-6">
                <span class="text-xs font-semibold tracking-[0.04em] text-neutral-500 uppercase">
                  {published ? <time datetime={published.toISOString()}>{published.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</time> : '—'}
                </span>
                <span class="text-base leading-snug font-semibold tracking-[-0.02em] text-primary-700">{(tpl.readingTimeLabel || '{n} min read').replace('{n}', String(minutes))}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    {/* ---- Cover ---------------------------------------------------------- */}
    <div class="padding-global">
      <div class="container-large">
        <figure class="case-study_cover relative aspect-[4/3] overflow-hidden rounded-3xl bg-primary-50 sm:aspect-[16/8] lg:aspect-[16/7]" data-reveal>
          {
            cover ? (
              <CmsImage media={cover} class="size-full object-cover" loading="eager" fetchpriority="high" sizes="(min-width: 80rem) 1280px, 100vw" />
            ) : (
              <div class="case-study_cover-fallback flex size-full items-center justify-center">
                <div class="case-study_cover-glow absolute inset-0" aria-hidden="true"></div>
                <Illustration media={service?.illustration} class="relative h-[62%] w-auto" loading="eager" decorative />
              </div>
            )
          }
        </figure>
      </div>
    </div>

    {/* ---- Key results ---------------------------------------------------- */}
    {
      item.results && item.results.length > 0 && (
        <section class="case-study_results padding-global mt-10 lg:mt-14" aria-labelledby="results-label">
          <div class="container-large">
            <h2 id="results-label" class="mb-5 text-sm font-semibold tracking-[0.04em] text-neutral-500 uppercase" data-reveal>{tpl.resultsLabel}</h2>
            <dl class="grid gap-4 sm:grid-cols-[repeat(auto-fit,minmax(14rem,1fr))] lg:gap-6">
              {item.results.map((r, i) => (
                <div class="case-study_result flex flex-col-reverse gap-3 rounded-2xl bg-white px-6 py-7 lg:px-8 lg:py-9" data-reveal style={`--reveal-delay: ${i * 80}`}>
                  <dt class="text-base leading-snug font-medium tracking-[-0.02em] text-neutral-600">{r.label}</dt>
                  <dd class="text-[clamp(2.5rem,2.5vw+1.5rem,3.75rem)] leading-none font-medium tracking-[-0.05em] text-primary-700">{r.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )
    }

    {/* ---- Story + contents ---------------------------------------------- */}
    <div class="padding-global">
      <div class="container-large">
        <div class="case-study_body grid gap-10 pt-14 pb-20 lg:grid-cols-[16.5rem_minmax(0,46rem)] lg:justify-between lg:gap-16 lg:pt-24 lg:pb-32" data-story>
          {
            toc.length > 0 && (
              <aside class="case-study_toc lg:sticky lg:top-10 lg:self-start" aria-label={tpl.tocLabel || 'On this page'}>
                {/* Phones: collapsible */}
                <details class="case-study_toc-mobile rounded-2xl border border-neutral-300 bg-white lg:hidden">
                  <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-semibold tracking-[0.04em] text-neutral-700 uppercase">
                    {tpl.tocLabel}
                    <span class="case-study_toc-chevron text-primary-500 transition-transform duration-300 [&_svg]:h-2 [&_svg]:w-3.5" aria-hidden="true" set:html={chevron} />
                  </summary>
                  <ol class="flex flex-col gap-1 px-5 pb-5">
                    {toc.map((t) => (
                      <li class:list={[t.level === 3 && 'pl-4']}>
                        <a href={`#${t.id}`} class="block py-1.5 text-[0.9375rem] leading-snug font-medium text-neutral-600">{t.text}</a>
                      </li>
                    ))}
                  </ol>
                </details>

                {/* Desktop: sticky list with a line that fills as you read */}
                <nav class="case-study_toc-desktop max-lg:hidden">
                  <p class="mb-6 text-sm font-semibold tracking-[0.04em] text-neutral-500 uppercase">{tpl.tocLabel}</p>
                  <div class="relative pl-6">
                    <span class="case-study_toc-track absolute top-0 bottom-0 left-0 w-0.5 rounded-full bg-neutral-300" aria-hidden="true">
                      <span class="case-study_toc-fill absolute inset-0 origin-top rounded-full bg-primary-600" data-toc-fill></span>
                    </span>
                    <ol class="flex flex-col gap-1" data-toc>
                      {toc.map((t) => (
                        <li>
                          <a
                            href={`#${t.id}`}
                            data-toc-link={t.id}
                            class:list={['case-study_toc-link block py-2 leading-snug tracking-[-0.02em]', t.level === 3 ? 'pl-4 text-sm' : 'text-[0.9375rem]']}
                          >
                            {t.text}
                          </a>
                        </li>
                      ))}
                    </ol>
                  </div>
                </nav>
              </aside>
            )
          }

          <div class:list={['case-study_content', toc.length === 0 && 'lg:col-start-2']}>
            <div class="rich-text" data-story-content set:html={html} />
            {
              item.tags && item.tags.length > 0 && (
                <ul class="case-study_tags mt-14 flex flex-wrap gap-2 border-t border-neutral-300 pt-8">
                  {item.tags.map((t) => (
                    <li class="rounded-full border border-neutral-500 px-4 py-3 text-sm leading-none font-medium tracking-[-0.02em] text-neutral-500">{t.label}</li>
                  ))}
                </ul>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && <CaseStudies block={relatedBlock} />}
  {cta && <Cta block={cta} />}
</Layout>

<style>
  .case-study_cover-glow {
    background:
      radial-gradient(60% 80% at 25% 30%, color-mix(in srgb, var(--color-primary-200) 70%, transparent), transparent 70%),
      radial-gradient(50% 70% at 80% 75%, color-mix(in srgb, var(--color-primary-300) 45%, transparent), transparent 70%);
  }
  .case-study_toc-mobile summary::-webkit-details-marker {
    display: none;
  }
  .case-study_toc-mobile[open] .case-study_toc-chevron {
    transform: rotate(180deg);
  }
  .case-study_toc-link {
    color: var(--color-neutral-500);
    font-weight: 500;
    transition: color 0.3s var(--ease-out-soft);
  }
  .case-study_toc-link:hover {
    color: var(--color-neutral-800);
  }
  .case-study_toc-link.is-active {
    color: var(--color-primary-700);
    font-weight: 600;
  }
  .case-study_toc-fill {
    transform: scaleY(var(--toc-progress, 0));
    will-change: transform;
  }
</style>

<script>
  import { onScroll } from '../../lib/scroll';

  // Scroll-spy for "On this page" + the fill line beside it. Positions are
  // measured once (and on resize); each scroll frame only compares numbers.
  const story = document.querySelector<HTMLElement>('[data-story-content]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const fill = document.querySelector<HTMLElement>('[data-toc-fill]');

  if (story && links.length) {
    const headings = links.map((a) => document.getElementById(a.dataset.tocLink!)).filter((h): h is HTMLElement => Boolean(h));
    let tops: number[] = [];
    let start = 0;
    let end = 1;
    let active = -1;

    const measure = () => {
      const y = window.scrollY;
      tops = headings.map((h) => h.getBoundingClientRect().top + y);
      const r = story.getBoundingClientRect();
      start = r.top + y;
      end = r.bottom + y;
    };

    const update = (y: number) => {
      const line = y + window.innerHeight * 0.3; // reading line, 30% down the screen
      let i = -1;
      for (let k = 0; k < tops.length; k++) if (tops[k] <= line) i = k;
      if (i !== active) {
        links[active]?.classList.remove('is-active');
        links[active]?.removeAttribute('aria-current');
        links[i]?.classList.add('is-active');
        links[i]?.setAttribute('aria-current', 'location');
        active = i;
      }
      const p = Math.min(1, Math.max(0, (line - start) / Math.max(1, end - start)));
      fill?.style.setProperty('--toc-progress', p.toFixed(4));
    };

    measure();
    new ResizeObserver(() => {
      measure();
      update(window.scrollY);
    }).observe(document.body);
    onScroll(update);
  }
</script>
