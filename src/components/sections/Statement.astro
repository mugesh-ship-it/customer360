---
/**
 * "Big statement" — one large centred sentence. Optional: section tag,
 * phrases in the brand colour (CMS "Words to colour", split by "|"),
 * and a row of small round images underneath.
 */
import CmsImage from '../global/CmsImage.astro';
import GridDivider from '../global/GridDivider.astro';
import SectionTag from '../global/SectionTag.astro';
import { sectionBg } from '../../lib/sections';
import type { BlockOf } from '../../lib/cms';

interface Props {
  block: BlockOf<'statement'>;
}
const { block } = Astro.props;

// Split the statement into plain / coloured segments, matching phrases in order of appearance.
const phrases = (block.highlights ?? '').split('|').map((p) => p.trim()).filter(Boolean);
const segments: { text: string; hl: boolean }[] = [];
let rest = block.text ?? '';
while (rest) {
  const hits = phrases.map((p) => ({ p, i: rest.indexOf(p) })).filter((h) => h.i >= 0).sort((a, b) => a.i - b.i);
  if (!hits.length) {
    segments.push({ text: rest, hl: false });
    break;
  }
  const { p, i } = hits[0];
  if (i > 0) segments.push({ text: rest.slice(0, i), hl: false });
  segments.push({ text: p, hl: true });
  rest = rest.slice(i + p.length);
}
const avatars = (block.avatars ?? []).filter((a) => typeof a === 'object');
const tagged = Boolean(block.tag);
---

<section class:list={['section_statement relative', sectionBg(block.background), tagged && block.background !== 'page' && 'is-blended']} id={block.anchorId || undefined}>
  {tagged && <GridDivider class="statement_divider pt-16 lg:pt-[10.6rem]" />}
  <div class="padding-global">
    <div class:list={[tagged ? 'container-large' : 'container-small']}>
      <div class:list={['statement_component flex flex-col items-center', tagged ? 'gap-7 pt-10 pb-20 lg:pt-[3.2rem] lg:pb-[10.5rem]' : '']}>
        {tagged && <SectionTag text={block.tag} data-reveal />}
        <p
          class:list={[
            'statement_text heading-style-h2 text-align-center mx-auto',
            tagged ? 'max-w-[69rem] leading-[1.29] text-neutral-800' : 'max-w-[52rem] py-12 text-neutral-900 lg:pt-[4.5rem] lg:pb-[4.5rem]',
          ]}
          data-reveal
        >
          {segments.map((s) => (s.hl ? <span class="statement_highlight text-primary-400">{s.text}</span> : s.text))}
        </p>
        {
          avatars.length > 0 && (
            <ul class="statement_avatars mt-5 flex items-center gap-0.5" data-reveal style="--reveal-delay: 150">
              {avatars.map((a) => (
                <li class="statement_avatar size-12 overflow-hidden rounded-full">
                  <CmsImage media={a} class="size-full object-cover" sizes="48px" />
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
  {!tagged && <GridDivider nodes={3} top bottom />}
</section>

<style>
  /* Tinted statement fades in from the page colour instead of starting on a hard edge. */
  .section_statement.is-blended {
    background-image: linear-gradient(180deg, var(--page-bg), transparent 10.8rem);
  }

  /* Photos get a white ring; icons (SVG) sit bare like the design's globe. */
  .statement_avatar:has(img:not([src$='.svg'])) {
    border: 2px solid #fff;
  }
</style>
