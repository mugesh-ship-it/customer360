---
import CmsImage from '../global/CmsImage.astro';
import GridDivider from '../global/GridDivider.astro';
import type { BlockOf } from '../../lib/cms';

interface Props {
  block: BlockOf<'logoMarquee'>;
}
const { block } = Astro.props;
const logos = block.logos ?? [];
---

<section class="section_logos relative" id={block.anchorId || undefined} aria-label="Partners and platforms">
  <div class="padding-global">
    <div class="container-large">
      <div class="logos_component relative overflow-hidden py-10 lg:py-[2.6rem]" data-reveal>
        <div class="logos_track flex w-max" style={`--marquee-duration: ${block.speed || 40}s`}>
          {
            [0, 1].map((copy) => (
              <ul class="logos_list flex shrink-0 items-center gap-14 pr-14 lg:gap-20 lg:pr-20" aria-hidden={copy === 1 ? 'true' : undefined}>
                {logos.map((item) => (
                  <li class="logos_item shrink-0">
                    <CmsImage
                      media={item.logo}
                      class="logos_image w-auto max-w-none opacity-60 grayscale transition-[filter,opacity] duration-500 hover:opacity-100 hover:grayscale-0"
                      style={`height: calc(${item.height || 48}px * var(--logo-scale, 1))`}
                      alt={copy === 1 ? '' : item.name}
                    />
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
        <div class="logos_fade pointer-events-none absolute inset-y-0 left-0 w-24 bg-linear-to-r from-page to-transparent lg:w-[19.4rem] lg:via-transparent lg:via-[48%]" aria-hidden="true"></div>
        <div class="logos_fade pointer-events-none absolute inset-y-0 right-0 w-24 bg-linear-to-l from-page to-transparent lg:w-[19.4rem] lg:via-transparent lg:via-[48%]" aria-hidden="true"></div>
      </div>
    </div>
  </div>
  <GridDivider top bottom class="mt-12 lg:mt-[4.18rem]" />
</section>

<style>
  .logos_component {
    --logo-scale: 0.75;
  }
  @media (min-width: 64rem) {
    .logos_component {
      --logo-scale: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .logos_track {
      animation: logos-marquee var(--marquee-duration) linear infinite;
      will-change: transform;
    }
    .logos_component:hover .logos_track {
      animation-play-state: paused;
    }
  }
  @keyframes logos-marquee {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
</style>
