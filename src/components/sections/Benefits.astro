---
/**
 * "Benefits list" — title + photo on the left, icon cards on the right.
 * One card can be highlighted in the brand colour; hovering any card moves the
 * highlight to it (CSS only). Icons are one-colour SVGs used as masks so they
 * recolour with the card.
 */
import CmsImage from '../global/CmsImage.astro';
import SectionTag from '../global/SectionTag.astro';
import { mediaUrl, type BlockOf } from '../../lib/cms';

interface Props {
  block: BlockOf<'benefits'>;
}
const { block } = Astro.props;
const items = block.items ?? [];
---

<section class="section_benefits" id={block.anchorId || undefined}>
  <div class="padding-global">
    <div class="container-large">
      <div class="benefits_component grid gap-12 py-16 lg:grid-cols-[35rem_1fr] lg:gap-16 lg:pt-[10.2rem] lg:pb-[5.5rem]">
        <div class="benefits_aside flex flex-col">
          <div class="benefits_header flex flex-col items-start gap-7" data-reveal>
            <SectionTag text={block.tag} />
            <h2 class="benefits_heading heading-style-h1 is-compact max-w-[40.5rem] text-neutral-800 lg:-mr-24">{block.heading}</h2>
          </div>
          <div class="benefits_visual mt-10 aspect-[560/555] overflow-hidden rounded-2xl bg-surface lg:mt-auto" data-reveal style="--reveal-delay: 100">
            <CmsImage media={block.image} class="benefits_image size-full object-cover" sizes="(min-width: 64rem) 560px, 100vw" />
          </div>
        </div>

        <div class="benefits_list-wrap relative lg:pt-[3.6rem]">
          <div class="benefits_axis pointer-events-none absolute -top-[12.4rem] bottom-0 left-1/2 -z-10 flex -translate-x-1/2 flex-col items-center max-lg:hidden" aria-hidden="true">
            <div class="grid-dot"></div>
            <div class="grid-line-v flex-1 -scale-y-100"></div>
          </div>
          <ul class="benefits_list flex h-full flex-col justify-between gap-6">
            {
              items.map((item, i) => {
                const icon = mediaUrl(item.icon);
                return (
                  <li
                    class:list={['benefits_card flex items-start gap-6 rounded-2xl p-6 lg:p-9', item.highlighted && 'is-active']}
                    data-reveal
                    style={`--reveal-delay: ${i * 80}`}
                  >
                    <span class="benefits_icon flex size-14 shrink-0 items-center justify-center rounded-full lg:size-16" aria-hidden="true">
                      {icon && <span class="benefits_glyph size-7 lg:size-8" style={`--icon: url('${icon}')`} />}
                    </span>
                    <div class="benefits_body flex flex-col gap-4 pt-1">
                      <h3 class="benefits_title heading-style-h3">{item.title}</h3>
                      {item.description && <p class="benefits_text text-size-regular font-medium">{item.description}</p>}
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .benefits_card {
    background: var(--color-surface);
    transition: background-color 0.4s var(--ease-out-soft);
  }
  .benefits_icon {
    background: var(--color-primary-600);
    color: var(--color-white, #fff);
    transition:
      background-color 0.4s var(--ease-out-soft),
      color 0.4s var(--ease-out-soft);
  }
  .benefits_glyph {
    background: currentColor;
    mask: var(--icon) center / contain no-repeat;
  }
  .benefits_title {
    color: var(--color-primary-700);
    transition: color 0.4s var(--ease-out-soft);
  }
  .benefits_text {
    color: var(--color-neutral-700);
    transition: color 0.4s var(--ease-out-soft);
  }

  /* Highlighted card, or the card under the pointer (the highlight follows the hover). */
  .benefits_card.is-active,
  .benefits_card:hover {
    background: var(--color-primary-600);
  }
  :is(.benefits_card.is-active, .benefits_card:hover) .benefits_icon {
    background: var(--color-surface);
    color: var(--color-primary-600);
  }
  :is(.benefits_card.is-active, .benefits_card:hover) .benefits_title {
    color: var(--color-primary-50);
  }
  :is(.benefits_card.is-active, .benefits_card:hover) .benefits_text {
    color: var(--color-neutral-50);
  }

  /* While another card is hovered, the highlighted one steps back. */
  @media (hover: hover) {
    .benefits_list:has(.benefits_card:hover) .benefits_card.is-active:not(:hover) {
      background: var(--color-surface);
    }
    .benefits_list:has(.benefits_card:hover) .benefits_card.is-active:not(:hover) .benefits_icon {
      background: var(--color-primary-600);
      color: var(--color-white, #fff);
    }
    .benefits_list:has(.benefits_card:hover) .benefits_card.is-active:not(:hover) .benefits_title {
      color: var(--color-primary-700);
    }
    .benefits_list:has(.benefits_card:hover) .benefits_card.is-active:not(:hover) .benefits_text {
      color: var(--color-neutral-700);
    }
  }
</style>
