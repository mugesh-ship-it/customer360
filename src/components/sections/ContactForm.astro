---
/**
 * "Contact form & offices". Posts to this site's /api/contact (which hands the message to the CMS),
 * so it works without JavaScript too; with JavaScript it sends in place and shows the thank-you.
 */
import SectionTag from '../global/SectionTag.astro';
import type { BlockOf } from '../../lib/cms';

interface Props {
  block: BlockOf<'contactForm'>;
}
const { block } = Astro.props;
const offices = block.offices ?? [];
const telHref = (n: string) => `tel:${n.replace(/[^\d+]/g, '')}`;

// "Read our {privacy policy}." → text with the braces part linked.
const consent = block.consentText || '';
const m = consent.match(/^(.*)\{(.+?)\}(.*)$/s);

const fields = [
  { name: 'firstName', label: block.firstNameLabel || 'First name', type: 'text', autocomplete: 'given-name', required: true, half: true },
  { name: 'lastName', label: block.lastNameLabel || 'Last name', type: 'text', autocomplete: 'family-name', required: true, half: true },
  { name: 'email', label: block.emailLabel || 'Email', type: 'email', autocomplete: 'email', required: true, half: true },
  { name: 'phone', label: block.phoneLabel || 'Phone', type: 'tel', autocomplete: 'tel', required: false, half: true },
  { name: 'company', label: block.companyLabel || 'Company', type: 'text', autocomplete: 'organization', required: true, half: false },
];
---

<section class="section_contact" id={block.anchorId || undefined}>
  <div class="padding-global">
    <div class="container-large">
      <div class="contact_component grid gap-12 pt-6 pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-20 lg:pt-10 lg:pb-32">
        {/* ---- Form ---- */}
        <div class="contact_form-card rounded-3xl bg-white p-6 sm:p-10 lg:p-14" data-reveal>
          <div class="mb-10 flex flex-col items-start gap-5">
            <SectionTag text={block.tag} />
            <h2 class="contact_heading heading-style-h2 text-neutral-800">{block.heading}</h2>
            {block.intro && <p class="contact_intro text-size-regular text-muted">{block.intro}</p>}
          </div>

          <div class="contact_success flex-col items-start gap-3 py-10" id="contact-sent" data-success role="status" tabindex="-1">
            <p class="heading-style-h3 text-primary-700">{block.successHeading}</p>
            <p class="text-size-regular text-neutral-700">{block.successText}</p>
          </div>

          <form class="contact_form grid gap-5 sm:grid-cols-2" method="post" action="/api/contact" data-contact-form novalidate>
            {
              fields.map((f) => (
                <label class:list={['contact_field flex flex-col gap-2', !f.half && 'sm:col-span-2']}>
                  <span class="contact_label text-sm font-semibold tracking-[-0.01em] text-neutral-700">
                    {f.label}
                    {f.required && <span class="text-primary-600" aria-hidden="true"> *</span>}
                  </span>
                  <input class="contact_input" name={f.name} type={f.type} autocomplete={f.autocomplete} required={f.required} maxlength={f.name === 'company' ? 160 : 200} />
                </label>
              ))
            }
            <label class="contact_field flex flex-col gap-2 sm:col-span-2">
              <span class="contact_label text-sm font-semibold tracking-[-0.01em] text-neutral-700">
                {block.messageLabel || 'Message'}<span class="text-primary-600" aria-hidden="true"> *</span>
              </span>
              <textarea class="contact_input min-h-40 resize-y py-3" name="message" required maxlength="5000" rows="5"></textarea>
            </label>
            {/* Bots fill every field; people never see this one. */}
            <label class="contact_trap" aria-hidden="true">
              Website <input name="website" type="text" tabindex="-1" autocomplete="off" />
            </label>
            <input type="hidden" name="page" value={Astro.url.pathname} />

            <p class="contact_error rounded-xl bg-red-50 px-4 py-3 text-sm font-medium text-red-700 sm:col-span-2" id="contact-error" data-error role="alert">
              {block.errorText}
            </p>

            <div class="flex flex-col items-start gap-4 sm:col-span-2">
              <button type="submit" class="button is-primary" data-submit data-sending={block.sendingLabel || 'Sending…'}>
                <span>{block.submitLabel || 'Send message'}</span>
              </button>
              {
                consent && (
                  <p class="contact_consent text-sm text-muted">
                    {m ? (<>{m[1]}<a href={block.privacyUrl || '/privacy'} class="text-primary-700 underline underline-offset-2">{m[2]}</a>{m[3]}</>) : consent}
                  </p>
                )
              }
            </div>
          </form>
        </div>

        {/* ---- Details & offices ---- */}
        <aside class="contact_details flex flex-col gap-10" data-reveal style="--reveal-delay: 100">
          {
            (block.email || block.phone) && (
              <ul class="flex flex-col gap-3">
                {block.email && (
                  <li>
                    <a href={`mailto:${block.email}`} class="contact_link text-[clamp(1.25rem,0.6vw+1rem,1.625rem)] font-medium tracking-[-0.03em] text-neutral-800">{block.email}</a>
                  </li>
                )}
                {block.phone && (
                  <li>
                    <a href={telHref(block.phone)} class="contact_link text-[clamp(1.25rem,0.6vw+1rem,1.625rem)] font-medium tracking-[-0.03em] text-neutral-800">{block.phone}</a>
                  </li>
                )}
              </ul>
            )
          }
          {
            offices.length > 0 && (
              <div class="flex flex-col gap-6">
                {block.officesHeading && <h2 class="text-sm font-semibold tracking-[0.04em] text-neutral-500 uppercase">{block.officesHeading}</h2>}
                <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-1">
                  {offices.map((o) => (
                    <li class="contact_office flex flex-col gap-2 border-l-2 border-primary-500 pl-5">
                      <h3 class="text-lg font-semibold tracking-[-0.02em] text-neutral-800">{o.city}</h3>
                      {o.address && (
                        <address class="text-size-regular leading-relaxed text-neutral-600 not-italic">
                          {o.address.split('\n').map((line, i) => (<>{i > 0 && <br />}{line}</>))}
                        </address>
                      )}
                      {o.phone && <a href={telHref(o.phone)} class="contact_link text-size-regular text-neutral-700">{o.phone}</a>}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </div>
  </div>
</section>

<style>
  .contact_input {
    width: 100%;
    min-height: 3.25rem;
    border-radius: 0.875rem;
    border: 1px solid var(--color-neutral-300);
    background: var(--color-page, #fff);
    padding: 0 1rem;
    font-size: 1rem;
    color: var(--color-neutral-800);
    transition:
      border-color 0.25s var(--ease-out-soft),
      box-shadow 0.25s var(--ease-out-soft);
  }
  .contact_input:focus {
    outline: none;
    border-color: var(--color-primary-500);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary-500) 18%, transparent);
  }
  .contact_input[aria-invalid='true'] {
    border-color: #dc2626;
  }
  /* Thank-you / error: shown by the script, or by #contact-sent / #contact-error after a no-JS send. */
  .contact_success,
  .contact_error {
    display: none;
  }
  .contact_success:target,
  .contact_success.is-visible {
    display: flex;
  }
  .contact_success:focus {
    outline: none;
  }
  .contact_success:target + .contact_form,
  .contact_form.is-hidden {
    display: none;
  }
  .contact_error:target,
  .contact_error.is-visible {
    display: block;
  }
  .contact_trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact_link {
    transition: color 0.25s var(--ease-out-soft);
  }
  .contact_link:hover {
    color: var(--color-primary-700);
  }
  [data-submit][disabled] {
    opacity: 0.6;
    pointer-events: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const section = form.closest('section')!;
    const success = section.querySelector<HTMLElement>('[data-success]')!;
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = submit.querySelector('span')!;
    const idle = label.textContent;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.classList.remove('is-visible');
      const invalid = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')].filter((el) => !el.checkValidity());
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      if (invalid.length) {
        invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
        invalid[0].focus();
        return;
      }
      submit.disabled = true;
      label.textContent = submit.dataset.sending ?? idle;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.classList.add('is-hidden');
        success.classList.add('is-visible');
        success.focus();
      } catch {
        error.classList.add('is-visible');
      } finally {
        submit.disabled = false;
        label.textContent = idle;
      }
    });
  });
</script>
